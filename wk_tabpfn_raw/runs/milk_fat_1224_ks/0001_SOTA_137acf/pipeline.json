[
  "nirs4all.operators.transforms.nirs.ASLSBaseline",
  {
    "y_processing": "sklearn.preprocessing._data.StandardScaler"
  },
  "sklearn.preprocessing._data.StandardScaler",
  {
    "split": {
      "class": "nirs4all.operators.splitters.splitters.SPXYGFold",
      "params": {
        "n_splits": 3,
        "random_state": 42
      }
    }
  },
  {
    "class": "sklearn.decomposition._pca.PCA",
    "params": {
      "n_components": 0.99,
      "whiten": true,
      "random_state": 42
    }
  },
  {
    "model": {
      "class": "tabpfn.regressor.TabPFNRegressor",
      "params": {
        "n_estimators": 4,
        "model_path": "tabpfn-v2.5-regressor-v2.5_real.ckpt",
        "device": "cpu",
        "ignore_pretraining_limits": true,
        "random_state": 42
      }
    },
    "name": "TabPFN-real"
  }
]